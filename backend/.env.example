# PharmaCore backend — copy to .env and fill. Never commit the real .env.
MEDLINK_ENV=dev
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=*
# SQLite (default) needs no services; use PostgreSQL for staging/production:
# DATABASE_URL=postgres://pharmacore:pharmacore@localhost:5432/pharmacore
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
