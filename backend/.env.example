# PharmaCore backend — copy to .env and fill. Never commit the real .env.
MEDLINK_ENV=dev
SECRET_KEY=change-me
# SQLite (default) needs no services; use PostgreSQL for staging/production:
# DATABASE_URL=postgresql+psycopg://pharmacore:pharmacore@localhost:5432/pharmacore
DATABASE_URL=sqlite+pysqlite:///./pharmacore_dev.db
JWT_ACCESS_TTL_MINUTES=30
LOG_LEVEL=info
